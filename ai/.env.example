# ==============================================================================
# AeroHealth Guard - AI & Spatial Microservice Environment Configuration
# ==============================================================================

# Application Environment
ENV=development
PORT=8000
HOST=0.0.0.0

# Database Connection (PostgreSQL + PostGIS)
# In Docker: postgresql://aerohealth:password@db:5432/aerohealth_db
# Local Dev: postgresql://aerohealth:password@localhost:5432/aerohealth_db
DATABASE_URL=postgresql://aerohealth:your_secure_password@localhost:5432/aerohealth_db

# External Air Quality API Credentials
WAQI_API_TOKEN=your_waqi_api_token_here
OPENAQ_API_KEY=your_openaq_api_key_here

# NASA FIRMS Satellite Hotspot API Key
NASA_FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# LLM Providers (Google Gemini & Groq API)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Cron Pipeline Interval
CRON_INTERVAL_HOURS=3
