# ==========================================
# Database (PostgreSQL + PostGIS)
# ==========================================
POSTGRES_USER=aerohealth
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=aerohealth_db

# For prod use db:port for local dev use localhost:port
DATABASE_URL=postgresql://aerohealth:your_secure_password@localhost:5432/aerohealth_db


# ==========================================
# Backend (Express.js) — Port 5000
# ==========================================
NODE_ENV=development
PORT=5000

# ==========================================
# Frontend (Next.js) — Port 3000
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:5000

# ==========================================
# AI / Python Microservice — Port 8000
# ==========================================

# External API Keys
WAQI_API_TOKEN=your_waqi_api_token
OPENAQ_API_KEY=your_openaq_api_key
NASA_FIRMS_MAP_KEY=your_nasa_firms_key

# LLM API Keys (choose one or both)
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Cron Schedule
CRON_INTERVAL_HOURS=3
